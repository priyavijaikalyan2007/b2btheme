      "type": "object",
      "properties": {
        "relationshipKey": {
          "type": "string",
          "description": "Relationship key, e.g. \"owned_by\"."
        },
        "displayName": {
          "type": "string",
          "description": "Display label, e.g. \"owned by\"."
        },
        "color": {
          "type": "string",
          "description": "Edge color hex. Default: #94a3b8."
        },
        "style": {
          "oneOf": [
