        },
        "role": {
          "type": "string",
          "description": "Who spoke."
        },
        "text": {
          "type": "string",
          "description": "Turn text. Untrusted — rendered via textContent only."
        },
        "revision": {
          "type": "number",
          "description": "Canvas revision this turn produced, when it produced one."
        }
      },
      "required": [
        "id",
        "role",
        "text"
      ],
      "description": "One conversation turn.",
      "additionalProperties": false
    },
