{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": ["page/**/*.ts"],
  "exclude": ["page/**/*.test.ts"]
}
