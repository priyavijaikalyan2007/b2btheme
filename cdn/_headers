# AGENT: Cloudflare Workers static-assets header rules for static.knobby.io.
# Copied to dist/_headers at build time (package.json copy:cdn). See
# CDN_CONTRACT.md for the caching policy rationale (Keycloak parity R4.3).
#
# NOTE: keep URL patterns DISJOINT — when multiple rules match a path,
# Cloudflare appends headers from every matching rule, which would emit
# duplicate Cache-Control headers.

# Icon fonts: content changes only with the bootstrap-icons package version.
# CORS header future-proofs cross-origin @font-face (auth.knobby.io) — R4.1.
/icons/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Vendored libraries (chart.js, ...) at UNVERSIONED paths: content changes on
# a dependency upgrade, so these can never be immutable. New assets go under
# /lib/ instead — see below.
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Dependency closure at IMMUTABLE VERSIONED paths (ADR-149, DEBT-SEC-4).
# The version is in the filename, so a given path never changes content and a
# browser may hold it indefinitely; a version bump is a new path. Every app
# shares one cache entry, which is the point — a library inside an app bundle
# is re-pushed on every deploy of that app.
#
# Access-Control-Allow-Origin is REQUIRED here, not optional: SRI forces
# crossorigin="anonymous", which makes even a <script src> request CORS. Omit
# it and every integrity-protected tag fails to load.
#
# Deliberately a separate prefix from /vendor/* — the two patterns must not
# overlap, or Cloudflare emits both Cache-Control headers (see the note at the
# top of this file). For the same reason the manifest lives at
# /lib-manifest.json rather than inside /lib/.
/lib/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# SRI manifest: consumers generate their script tags from this, so it must
# never be stale — a cached manifest would pair a new URL with an old hash.
/lib-manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Parity-critical "latest" assets: short freshness so fixes propagate to
# auth.knobby.io within minutes, stale-while-revalidate keeps loads fast.
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/components/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Build metadata: always revalidate — consumers use it to see what is live.
/build.json
  Cache-Control: no-cache

# Agent-protocol artefacts (ADR-219): the A2UI catalog is a permanent public
# identifier that third-party tools fetch cross-origin, so CORS is open.
/a2ui/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/schemas/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/mcp/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Demo videos (#30 spec §7.4): an unversioned path whose content changes
# when a scenario is re-recorded, so never immutable. A day's cache keeps a
# long video off the origin; a re-recording shows within a day.
/demo/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icon packs (docs/ICON_PACKS.md, specs/icon-packs.plan.md). Unversioned paths:
# a repack changes content in place, so never immutable. CORS is open so apps
# can fetch() manifests and inline SVGs; the CSP stops an SVG opened directly
# in a tab from running anything. One rule per pack keeps the patterns
# disjoint from /icons/fonts/*.
/icons/fluent-ui/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:

/icons/fluent-emoji/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:

/icons/aws/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:

/icons/azure/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:

/icons/gcp/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
